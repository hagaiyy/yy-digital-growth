{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yy-digital-growth/schemas/performance_snapshot.v1.0.0.schema.json",
  "title": "performanceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "metricRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerMetric", "internalMetric", "value", "nativeUnit", "status", "sourceEndpoint"],
      "properties": {
        "providerMetric": { "type": "string", "minLength": 1 },
        "internalMetric": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string", "null"] },
        "nativeUnit": { "type": "string", "minLength": 1 },
        "normalizedValue": { "type": ["number", "string", "null"] },
        "normalizedUnit": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "available",
            "empty",
            "unsupported",
            "invalidForContentType",
            "permissionRequired",
            "accessReviewRequired",
            "deprecated",
            "untested",
            "providerError",
            "noFacebookDistribution",
            "notCrossposted",
            "invalidForApiModel",
            "eligibilityUnknown"
          ]
        },
        "period": { "type": "string", "minLength": 1 },
        "sourceEndpoint": { "type": "string", "minLength": 1 },
        "safeReasonCode": { "type": "string", "minLength": 1 },
        "safeReasonMessage": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": [
    "schemaVersion",
    "performanceSnapshotId",
    "importedContentId",
    "connectionId",
    "platform",
    "snapshotHour",
    "collectedAt",
    "metrics",
    "dataCompleteness",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "performanceSnapshotId": { "type": "string", "minLength": 1 },
    "importedContentId": { "type": "string", "minLength": 1 },
    "connectionId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["instagram", "facebook", "pinterest"] },
    "snapshotHour": { "type": "string", "format": "date-time" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "metrics": { "type": "object" },
    "dataCompleteness": { "type": "string", "enum": ["complete", "partial", "unavailable", "untested"] },
    "accountType": { "type": "string", "minLength": 1 },
    "contentType": {
      "type": "string",
      "enum": [
        "reel",
        "story",
        "imageStory",
        "videoStory",
        "unknownStory",
        "imagePost",
        "carousel",
        "video",
        "feedVideo",
        "textPost",
        "linkPost",
        "album",
        "pin",
        "videoPin",
        "unknown"
      ]
    },
    "providerObjectType": { "type": "string", "minLength": 1 },
    "providerMediaType": { "type": "string", "minLength": 1 },
    "providerMediaProductType": { "type": "string", "minLength": 1 },
    "metricRecords": { "type": "array", "items": { "$ref": "#/$defs/metricRecord" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
