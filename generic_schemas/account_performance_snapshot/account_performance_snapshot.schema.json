{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yy-digital-growth/schemas/account_performance_snapshot.v1.0.0.schema.json",
  "title": "accountPerformanceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "accountMetricRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerMetric", "internalMetric", "value", "nativeUnit", "status", "sourceEndpoint"],
      "properties": {
        "providerMetric": { "type": "string", "minLength": 1 },
        "internalMetric": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string", "null"] },
        "nativeUnit": { "type": "string", "minLength": 1 },
        "normalizedValue": { "type": ["number", "string", "null"] },
        "normalizedUnit": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "empty",
            "unsupported",
            "invalidForContentType",
            "permissionRequired",
            "accessReviewRequired",
            "deprecated",
            "untested",
            "providerError"
          ]
        },
        "period": { "type": "string", "minLength": 1 },
        "breakdown": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "sourceEndpoint": { "type": "string", "minLength": 1 },
        "safeReasonCode": { "type": "string", "minLength": 1 },
        "unavailableDueToAccountSize": { "type": "boolean" }
      }
    }
  },
  "required": [
    "schemaVersion",
    "accountPerformanceSnapshotId",
    "connectionId",
    "platform",
    "snapshotHour",
    "collectedAt",
    "period",
    "completeness",
    "metrics",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "accountPerformanceSnapshotId": { "type": "string", "minLength": 1 },
    "connectionId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["instagram", "facebook", "pinterest"] },
    "accountType": { "type": "string", "minLength": 1 },
    "snapshotHour": { "type": "string", "format": "date-time" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "period": { "type": "string", "minLength": 1 },
    "since": { "type": "string", "minLength": 1 },
    "until": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "breakdown": { "type": "string", "minLength": 1 },
    "completeness": { "type": "string", "enum": ["complete", "partial", "unavailable", "untested"] },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/accountMetricRecord" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
